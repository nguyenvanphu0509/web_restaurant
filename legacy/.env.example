SSR_PORT=3001
SSR_ORIGIN=http://localhost:3001
SSR_SESSION_SECRET=
# Optional; defaults to DATABASE_URL from api/.env
# SSR_DATABASE_URL=postgresql://...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SSR_SEED_EMAIL=
SSR_SEED_PASSWORD=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Separate AES-256-GCM key, base64 of 32 random bytes; block9:migrate generates it locally.
MFA_ENCRYPTION_KEY=
# Opt-in only, demo accounts in example.test; never overwrites existing accounts.
BLOCK9_ALLOW_DEMO_SEED=false
